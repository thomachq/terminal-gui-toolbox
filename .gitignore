# ─────────────────────────────────────────────────────────────
# 运行期数据：CA 私钥、设备证书私钥、连接档案密文、API 令牌
# 这是使用者本机产生的机密，任何情况下都不入库
# ─────────────────────────────────────────────────────────────
data/

# ── 打包产物 ──
*.exe
*.bak-*
build/
dist/

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ── 本地调试残留 ──
build_log.txt
dbg*.txt
out.txt
err.txt

# ── 本机专用的启动器（写死了本机解释器路径，不进仓库）──
*.local.cmd
.venv/

# ── 编辑器 / 系统 ──
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# ── 自测产生的 PKI 样本（里面有 CA 私钥，绝不入库）──
_test_data/

# 构建与提交用的临时文件。日志一律不进库 —— 仓库里没有需要跟踪的 .log，
# 而构建 / 提交 / 打 tag 每次都往根目录丢一个，逐个列名字总有漏的。
*.log
_commitmsg.txt
_release/
_tagmsg.txt
/query

# rm 被安全守护拦时改名保留的旧构建目录
build.prev-*/
